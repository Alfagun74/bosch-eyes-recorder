# Copy this file to .env and adjust it. Docker Compose loads .env automatically.
# Never commit your real .env (it is git-ignored).

# Strongly recommended: password for the web UI (user "admin").
WEB_PASSWORD=change-me-to-a-strong-password

# Retention and recording
RETENTION_DAYS=7
SEGMENT_MINUTES=10
HIGH_QUALITY=false
TZ=Europe/Berlin

# Storage guards
MIN_FREE_GB=5
MAX_STORAGE_GB=0

# Camera selection (optional; defaults work for a single camera)
# CONNECTION_TYPE=LOCAL
# BOSCH_CAMERA_ID=
# BOSCH_CAMERA_NAME=
# CAMERA_HOST=

# Optional bootstrap token; normally use the web UI at /login instead.
# BOSCH_REFRESH_TOKEN=

# MediaMTX release downloaded during image build (pinned, tested version).
MEDIAMTX_VERSION=1.21.1

# ---------------------------------------------------------------------------
# Optional: AV1/Opus hardware transcoding (Intel Arc / QSV)
# Requires the docker-compose.qsv.yml override and /dev/dri in the container.
# TRANSCODE_ENABLED=false
# TRANSCODE_CONTAINER=webm          # webm (browser), mkv (VLC), mp4
# TRANSCODE_QUALITY=32              # lower = better/larger; 20..45 is typical
# TRANSCODE_PRESET=slow             # QSV preset: veryfast..veryslow
# TRANSCODE_AUDIO_BITRATE=48k
# TRANSCODE_BITRATE=                # optional: use a target bitrate instead of quality
# TRANSCODE_EXISTING=true           # also convert existing .mp4 recordings
# RENDER_GID=109                    # host "render" group id (getent group render)
# FFPROBE_BINARY=/usr/lib/jellyfin-ffmpeg/ffprobe
