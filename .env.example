# Copy this file to .env and adjust it. Docker Compose loads .env automatically.
# Never commit your real .env (it is git-ignored).

# Strongly recommended: password for the web UI (user "admin").
WEB_PASSWORD=change-me-to-a-strong-password

# Retention and recording
RETENTION_DAYS=7
SEGMENT_MINUTES=10
HIGH_QUALITY=false
TZ=Europe/Berlin

# Storage guards
MIN_FREE_GB=5
MAX_STORAGE_GB=0

# Camera selection (optional; defaults work for a single camera)
# CONNECTION_TYPE=LOCAL
# BOSCH_CAMERA_ID=
# BOSCH_CAMERA_NAME=
# CAMERA_HOST=

# Optional bootstrap token; normally use the web UI at /login instead.
# BOSCH_REFRESH_TOKEN=

# MediaMTX release downloaded during image build (pinned, tested version).
MEDIAMTX_VERSION=1.21.1
